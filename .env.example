# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── Required ────────────────────────────────────────────────
BOT_TOKEN=
STRING_SESSION=
MONGODB_URI=mongodb://localhost:27017
OWNER_ID=

# ── Telegram app (public test creds — override for production) ─
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627

# ── Optional ────────────────────────────────────────────────
# Comma/space-separated user IDs seeded as admins on first startup
INITIAL_ADMIN_IDS=
GROUP=nub_coder_s
LOGGER_ID=
DB_NAME=musicbot
YOUTUBE_API_KEYS=
YTUBE_API_BASE_URL=https://api.nubcoders.com
YTUBE_API_TOKEN=
# yt-dlp cookies.txt path (age-restricted / region-locked videos)
YT_COOKIES_FILE=
# Export cookies from a local browser profile into the cookies file at startup.
# One or more of: firefox chrome chromium edge brave opera vivaldi safari whale
# (comma/space-separated — each tried in order until one works).
# Requires that browser installed & logged in on the host. Blank = disabled.
COOKIES_FROM_BROWSER=
# URL yt-dlp hits during the export so it exits cleanly and validates the cookies.
COOKIES_BOOTSTRAP_URL=https://www.youtube.com/watch?v=jNQXAC9IVRw
# Re-export the cookie file every N hours (YouTube rotates tokens mid-session). 0 disables.
COOKIES_REFRESH_HOURS=6
# Spotify Web API — play Spotify links via YouTube (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
