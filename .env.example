# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── Required ────────────────────────────────────────────────
BOT_TOKEN=
STRING_SESSION=
MONGODB_URI=mongodb://localhost:27017

# OWNER_ID is OPTIONAL. Set it to your numeric Telegram user ID (from
# @userinfobot) to grant one account unrestricted rights. Leave it EMPTY to run
# an ownerless bot: the "creator" button is omitted from /start and owner-only
# commands are reachable only through SUDO / INITIAL_ADMIN_IDS. If you leave it
# empty, set INITIAL_ADMIN_IDS below or nobody can administer the bot.
OWNER_ID=

# Comma-separated user IDs seeded as bot admins on first startup. This is the
# bootstrap path when OWNER_ID is empty.
INITIAL_ADMIN_IDS=

# ── Multi-Assistant Mode (Optional) ──────────────────────────
# Provide additional Pyrogram string sessions to run multiple assistants concurrently.
# Useful for high-traffic bots, load balancing, and bypassing 500-group limits.
STRING_SESSION2=
STRING_SESSION3=
STRING_SESSION4=
STRING_SESSION5=
# Auto-leave idle chats for assistants to stay below 500 groups limit
AUTO_LEAVING_ASSISTANT=True
ASSISTANT_LEAVE_TIME=5400
# Safety rails for the sweep: cap leaves per pass (0 = unlimited) and
# rehearse with DRY_RUN=True to log every would-be leave without leaving.
ASSISTANT_MAX_LEAVES_PER_SWEEP=10
ASSISTANT_LEAVE_DRY_RUN=False

# ── Telegram app (public test creds — override for production) ─
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627

# ── Optional ────────────────────────────────────────────────
# Comma/space-separated user IDs seeded as admins on first startup
INITIAL_ADMIN_IDS=
GROUP=nub_coder_s
LOGGER_ID=
DB_NAME=musicbot
YOUTUBE_API_KEYS=
YTUBE_API_BASE_URL=https://api.nubcoders.com
YTUBE_API_TOKEN=
# yt-dlp cookies.txt path (age-restricted / region-locked videos)
YT_COOKIES_FILE=
# Export cookies from a local browser profile into the cookies file at startup.
# One or more of: firefox chrome chromium edge brave opera vivaldi safari whale
# (comma/space-separated — each tried in order until one works).
# Requires that browser installed & logged in on the host. Blank = disabled.
COOKIES_FROM_BROWSER=
# URL yt-dlp hits during the export so it exits cleanly and validates the cookies.
COOKIES_BOOTSTRAP_URL=https://www.youtube.com/watch?v=jNQXAC9IVRw
# Re-export the cookie file every N hours (YouTube rotates tokens mid-session). 0 disables.
COOKIES_REFRESH_HOURS=6
# Spotify Web API — play Spotify links via YouTube (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
